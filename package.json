{
  "name": "clinic-booking-api",
  "version": "1.0.0",
  "description": "REST API for booking clinic appointment slots. Node, Express and Postgres, with API key auth, concurrency-safe bookings, idempotency, cursor pagination and rate limiting.",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "node --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "seed": "tsx scripts/seed.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Atim-01/clinic-booking-api.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Atim-01/clinic-booking-api/issues"
  },
  "homepage": "https://github.com/Atim-01/clinic-booking-api#readme",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
